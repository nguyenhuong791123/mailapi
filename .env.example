# Mail API settings (copy to .env). Mail server accounts are configured here only.

# Access tokens of the token server (same as be: JWT_JWKS_URI / JWT_PUBLIC_KEY / JWT_SECRET)
JWT_JWKS_URI=http://localhost:8089/oauth2/jwks
JWT_ALGORITHMS=RS256
# JWT_ISSUER=
# JWT_AUDIENCE=
# false only for local tests without the token server
AUTH_REQUIRED=true

# Browser origins allowed to call the API (comma separated, * = one sub-domain label)
CORS_ORIGINS=http://localhost:1234
# Entries may be regular expressions, e.g. http://[a-z0-9-]+\.localhost:1234
# Entries may be regular expressions, e.g. http://[a-z0-9-]+\.localhost:1234

# SMTP (security: ssl | starttls | none)
MAIL_SMTP_HOST=smtp.example.com
MAIL_SMTP_PORT=587
MAIL_SMTP_SECURITY=starttls
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=

# IMAP / POP3 (user / password default to the SMTP account; leave HOST empty to disable)
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_IMAP_SECURITY=ssl
MAIL_IMAP_MAILBOX=INBOX
MAIL_POP3_HOST=
MAIL_POP3_PORT=995
MAIL_POP3_SECURITY=ssl

# Limits
MAIL_TIMEOUT=15
MAIL_MAX_MAILS=20
MAIL_MAX_RECIPIENTS=50
MAIL_MAX_FETCH=100
MAX_CONTENT_MB=25

# Mail accounts per tenant from the API server (サーバー情報 of the tenant DB: E-mail SMTP / POP3).
# When set, the MAIL_* accounts above are not used. Secret: same value as be INTERNAL_API_SECRET.
SERVER_SETTINGS_URI=
INTERNAL_API_SECRET=
# Seconds the accounts of a tenant are cached
SERVER_SETTINGS_TTL=60
